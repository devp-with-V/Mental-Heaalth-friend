# ─── Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local for local dev. On Vercel, set these in
# Project Settings → Environment Variables instead (NEXT_PUBLIC_* vars are
# inlined at build time, so redeploy after changing them).

# Backend API base (no trailing slash). Production:
NEXT_PUBLIC_BACKEND_URL=https://mindmate-api.antideploy.com/api
# Local dev:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api
